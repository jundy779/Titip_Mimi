NODE_ENV=production
PORT=3000
DATABASE_PATH=/data/mimi.sqlite
STATIC_DIR=../dist
# OAuth Client ID tipe "Web application" dari Google Cloud Console. Boleh lebih dari satu, pisahkan koma.
GOOGLE_CLIENT_ID=
# Pilot pribadi: hanya email ini yang bisa masuk. Wajib diisi untuk produksi.
ALLOWED_EMAILS=
# Origin web lain yang boleh memanggil API dengan token (misalnya demo lama untuk migrasi).
ALLOWED_ORIGINS=
SESSION_DAYS=30

# Telegram (opsional). Kosongkan TELEGRAM_BOT_TOKEN untuk mematikan bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# webhook (bawaan, butuh PUBLIC_URL https) atau polling (tanpa domain)
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_URL=
REMINDER_EVERY_MS=30000
