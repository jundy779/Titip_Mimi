NODE_ENV=production
PORT=3000
DATABASE_PATH=/data/mimi.sqlite
STATIC_DIR=../dist
# OAuth Client ID tipe "Web application" dari Google Cloud Console. Boleh lebih dari satu, pisahkan koma.
GOOGLE_CLIENT_ID=
# Pilot pribadi: hanya email ini yang bisa masuk. Wajib diisi untuk produksi.
ALLOWED_EMAILS=
# Origin web lain yang boleh memanggil API dengan token (misalnya demo lama untuk migrasi).
ALLOWED_ORIGINS=
SESSION_DAYS=30

# Telegram (opsional). Paling mudah: kosongkan, lalu pasang bot dari Profil di web.
# Bila diisi di sini, bot dari environment diutamakan dan tidak bisa diganti dari Profil.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Bot dari Profil: webhook otomatis bila PUBLIC_URL https, selain itu polling.
# Bot dari environment: webhook (bawaan, butuh secret dan PUBLIC_URL) atau polling.
TELEGRAM_MODE=webhook
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_URL=
REMINDER_EVERY_MS=30000

# Notifikasi walau web ditutup (Web Push). Boleh kosong: kunci dibuat sekali dan disimpan di database.
# Isi bila ingin kunci tetap sama walau database diganti (buat dengan: npx web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontak untuk layanan push (mailto: atau https:). Bawaan: PUBLIC_URL bila https.
VAPID_SUBJECT=
