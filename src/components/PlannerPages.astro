---
import ThemeChoice from './ThemeChoice.astro';
---
<template id="agenda-template">
  <section class="page-frame">
    <div class="page-heading"><h1>Agenda</h1><button class="primary" data-add>Tambah agenda</button></div>
    <div class="planner-columns">
      <div class="sheet timeline" data-schedule></div>
      <aside class="sheet import-calendar"><h2>Kalender lain</h2><div data-calendar-import></div></aside>
    </div>
  </section>
</template>
<template id="profile-template">
  <section class="page-frame">
    <div class="page-heading"><h1>Profil Iqlima</h1></div>
    <div class="planner-columns">
      <section class="sheet preferences">
        <img class="profile-mimi" src="peek.webp" alt="" />
        <h2>Ruang pribadimu</h2>
        <p>Titipanmu tersimpan di browser ini. Mimi bisa mengingatkan selama halamannya terbuka.</p>
        <ThemeChoice />
      </section>
      <section class="sheet connections"><h2>Koneksi Mimi</h2>
        <div><h3>Google Kalender</h3><p>Ambil agenda dari file kalender, atau kirim satu agenda ke Google Kalender.</p><button data-open-agenda>Buka Agenda</button></div>
        <div><h3>Telegram</h3><p>Belum terhubung. Kiriman foto lewat Telegram akan tersedia setelah layanan akun aktif.</p></div>
      </section>
    </div>
  </section>
</template>
