---
const extras = ['Target', 'Rawat diri', 'Catatan', 'Pengingat'];
---
<section class="sheet mimi-list" aria-labelledby="list-heading">
  <div class="list-heading">
    <img src="/bow.webp" width="42" height="36" alt="" />
    <h2 id="list-heading">To-Do List</h2>
    <label class="list-date"><span>Tanggal</span><input type="date" data-list-date required /></label>
  </div>
  <section class="list-group list-main" data-list-group="Tugasku">
    <h3>Tugasku</h3>
    <form><input aria-label="Tambah ke Tugasku" placeholder="Tulis tugas…" required maxlength="240" /><button type="submit">Tambah</button></form>
    <div data-rows></div>
  </section>
  <div class="list-extras">
    {extras.map((name,i) => <details class="list-fold">
      <summary>{name}<small data-summary={name}></small></summary>
      {i < 2 ? <div class="list-group" data-list-group={name}>
        <div data-rows></div>
        <form><input aria-label={'Tambah ke '+name} placeholder={i === 0 ? 'Tulis target…' : 'Waktu untuk dirimu…'} required maxlength="240" /><button type="submit">Tambah</button></form>
      </div> : <textarea aria-label={name} data-memo={name} rows="2" maxlength="2000" placeholder={name === 'Catatan' ? 'Tulis catatan…' : 'Tulis pesan untuk dirimu…'} />}
    </details>)}
  </div>
  <label class="list-priority">Prioritas hari ini <select data-list-priority><option value="">Pilih</option><option>Santai</option><option>Penting</option><option>Utama</option></select></label>
  <small data-list-status role="status"></small>
</section>
