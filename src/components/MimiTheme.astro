---
import tokens from '../../design/tokens.json';
const dark = Object.entries(tokens.darkColor).map(([key,value]) => `--mimi-${key}:${value}`).join(";");
const vars = [
  ...Object.entries(tokens.motion).map(([key,value]) => `--mimi-motion-${key}:${value}ms`),
  ...Object.entries(tokens.color).map(([key,value]) => `--mimi-${key}:${value}`),
  ...['space','radius','type'].flatMap(group =>
    Object.entries(tokens[group as 'space' | 'radius' | 'type']).map(([key,value]) => `--mimi-${group}-${key}:${value / 16}rem`)),
  `--mimi-target:${tokens.target / 16}rem`
];
---
<style is:inline set:html={`:root{color-scheme:light;${vars.join(';')}}:root[data-theme=dark]{color-scheme:dark;${dark}}`}></style>
<script is:inline>
  (() => {
    const key = 'titip-mimi-theme';
    const root = document.documentElement;
    let mode = 'light';
    function apply(value) {
      mode = value === 'dark' ? 'dark' : 'light';
      root.dataset.theme = mode;
      document.querySelectorAll('[data-dark-switch]').forEach(field => field.checked = mode === 'dark');
    }
    try { apply(localStorage.getItem(key)); } catch { apply('light'); }
    window.addEventListener('storage', event => { if (event.key === key || event.key === null) apply(event.newValue); });
    document.addEventListener('change', event => {
      const field = event.target;
      if (!field.matches('[data-dark-switch]')) return;
      apply(field.checked ? 'dark' : 'light');
      try { localStorage.setItem(key, mode); } catch {}
    });
    document.addEventListener('mimi-theme-mounted', () => apply(mode));
    document.addEventListener('DOMContentLoaded', () => apply(mode));
  })();
</script>
