<dialog id="box">
<form id="form">
<h2>Titip ke Mimi ♡</h2>
<label>Judul titipan<input id="judul" required maxlength="100" placeholder="Misalnya, ambil jahitan">
</label>
<label>Catatan<textarea id="isi" placeholder="Tulis seadanya, yaa" rows="3">
</textarea>
</label>
<label>Masuk agenda kapan? <small>(boleh kosong)</small>
<input id="waktu" type="datetime-local">
</label>
<div class="row">
<button type="button" id="cancel">Batal</button>
<button class="primary">Simpan titipan</button>
</div>
</form>
</dialog>
